# ==========================================
# VAULT BACKEND CONFIGURATION
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in Production, Local in Dev)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vault?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vault

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Do NOT use * in production with credentials)
CORS_ORIGIN=http://localhost:3000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=500
STORAGE_PATH=./storage

# Storage Node Heartbeat & Failure Detection
NODE_HEARTBEAT_TIMEOUT_MS=15000

# Background Cryptographic Integrity Scrubbing
INTEGRITY_SCAN_INTERVAL_MS=60000
INTEGRITY_SCAN_BATCH_SIZE=10

# Self-Healing Repair Worker Concurrency
MAX_CONCURRENT_REPAIRS=3

# Storage Rebalancing
REBALANCE_THRESHOLD_PERCENT=20
DEFAULT_DURABILITY_POLICY=QUORUM
DEFAULT_READ_POLICY=ANY_HEALTHY

# VaultOps AI Assistant Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_api_key_here

# Demo Initialization & Seed Guard (true for local hackathon demo, false in strict production)
DEMO_MODE=true
